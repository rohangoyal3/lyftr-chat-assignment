# Enter two distinct keys with access to LLM_MODEL.
LLM_API_KEYS=replace-me-1,replace-me-2
LLM_MODEL=gemini/gemini-3.5-flash-lite
# Optional OpenAI-compatible base URL or provider override.
LLM_API_BASE=

# Docker defaults to sqlite:////data/app.db. Standalone defaults to sqlite:///./data/app.db.
# DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENABLE_FAILURE_SIMULATION=true
DEFAULT_SYSTEM_PROMPT=You are Lyftr, a helpful assistant. Give clear, accurate answers.
LLM_TIMEOUT_SECONDS=20
CACHE_TTL_SECONDS=3600
HOST=0.0.0.0
PORT=8000
VITE_API_BASE_URL=http://localhost:8000
